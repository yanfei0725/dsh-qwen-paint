# 统一换行符：不加的话 Windows 提交的文件被 Linux/macOS clone 下来会全变 CRLF
* text=auto eol=lf

# 二进制文件（不要做换行转换）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.exe   binary
*.safetensors binary

# .cmd / .bat 必须 CRLF，否则 Windows 上可能不执行
*.cmd   text eol=crlf
*.bat   text eol=crlf
