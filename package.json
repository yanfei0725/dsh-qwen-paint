{
  "name": "dsh-qwen-paint",
  "version": "0.19.1",
  "description": "DSH 插件 / DeepSeek Harness：本地文生图、图生图、局部重绘、元素移除、四向扩图与高清放大。经本机 ComfyUI 调用 Qwen-Image 2.1 / 官方 Turbo，出图数据仅走 127.0.0.1 回环，无需 API 密钥、零调用费用。Windows / Linux，NVIDIA / Intel Arc / AMD 显卡。",
  "meta": {
    "title": "(绘图)千问",
    "description": "DSH 插件 / DeepSeek Harness：本地文生图、图生图、局部重绘、元素移除、四向扩图与高清放大。经本机 ComfyUI 调用 Qwen-Image 2.1 / 官方 Turbo，出图数据仅走 127.0.0.1 回环，无需 API 密钥、零调用费用。Windows / Linux，NVIDIA / Intel Arc / AMD 显卡。"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:selftest": "node scripts/selftest.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "node": ">=18.0.0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.5": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible"
      },
      "note": "兼容性依据 manifest + patch + 加载/注册 + 本机 ComfyUI 端到端冒烟验证；未列出的版本保持 unknown。"
    },
    "build": {
      "strategy": "none",
      "note": "lib/ 下的文件即为最终运行代码，无构建步骤、无 prepare 契约；npm 发布物由 files 白名单直接打包源码。"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "qwen-image",
    "image-generation"
  ],
  "homepage": "http<本地路径>#readme",
  "bugs": {
    "url": "http<本地路径>"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "@奇迹与你",
  "contributors": [
    "@yanfei0725"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http<本地路径>"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "original": {
    "repository": "http<本地路径>",
    "author": "@奇迹与你"
  }
}
